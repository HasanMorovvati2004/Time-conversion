import re
import sys


def main():
    print(convert(input("Hours: ")))


def convert(s):
    formating = re.search(r"^(([0-9][0-2]*):*([0-5][0-9])*) ([A-P]M) to (([0-9][0-2]*):*([0-5][0-9])*) ([A-P]M)$" , s)
    if formating:
        hm = formating.groups()
        if int(hm[1]) > 12 or int(hm[5]) > 12:
            raise ValueError
        first = format(hm[1],hm[2],hm[3])
        first1= format(hm[5],hm[6],hm[7])
        return first + " to " +first1
    else:
         raise ValueError
def format(hour , min , am_pm):
    if am_pm == "PM":
        if int(hour) ==12:
            new_hour =12
        else:
            new_hour = int(hour) +12
    else:
        if int(hour) ==12:
            new_hour =0
        else:
            new_hour= int(hour)
    if min == None:
        new_min= "00"
        new_time=f"{new_hour:02}"+ ":"  + new_min
    else:
        new_time = f"{new_hour:02}"  +":"+  min
    return new_time

